{
  "name": "torrent-service",
  "version": "1.0.0",
  "description": "Standalone WebTorrent microservice — REST API + WebSocket events",
  "type": "module",
  "private": true,
  "main": "index.mjs",
  "scripts": {
    "start": "node index.mjs",
    "dev": "node --watch index.mjs",
    "rebuild-native": "node -e \"const{execSync}=require('child_process'),path=require('path'),dir=path.dirname(require.resolve('node-datachannel/package.json'));execSync('node node_modules/.bin/prebuild-install -r napi',{cwd:dir,stdio:'inherit'})\""
  },
  "dependencies": {
    "webtorrent": "^2.8.5",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=18"
  },
  "trustedDependencies": [
    "node-datachannel",
    "utp-native"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-datachannel",
      "utp-native"
    ]
  }
}
